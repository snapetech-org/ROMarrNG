          "line": 26,
          "text": "UI_CATALOG = json.loads(Path(__file__).with_name(\"ui-labels.json\").read_text(encoding=\"utf-8\"))"
        },
        {
          "line": 27,
          "text": "if UI_CATALOG.get(\"schemaVersion\") != 3:"
        },
        {
          "line": 28,
          "text": "    raise ValueError(\"ROMarr UI translation catalog must use stable-key schema v3\")"
        },
        {
          "line": 29,
          "text": "UI_CATALOG_JSON = (json.dumps(UI_CATALOG, ensure_ascii=False, separators=(\",\", \":\"))"
        },
        {
          "line": 30,
          "text": "                   .replace(\"<\", \"\\\\u003c\").replace(\">\", \"\\\\u003e\")"
        },
        {
          "line": 31,
          "text": "                   .replace(\"&\", \"\\\\u0026\").replace(\"\\u2028\", \"\\\\u2028\")"
        },
        {
          "line": 32,
          "text": "                   .replace(\"\\u2029\", \"\\\\u2029\"))"
        },
        {
          "line": 33,
          "text": "UI_MESSAGES = UI_CATALOG[\"messages\"]"
        },
        {
          "line": 34,
          "text": "UI_SOURCE_TO_ID = {message[\"source\"]: key for key, message in UI_MESSAGES.items()}"
        },
        {
          "line": 35,
          "text": ""
        },
        {
          "line": 36,
          "text": ""
        },
        {
          "line": 37,
          "text": "def _ui_key(source: str) -> str:"
        },
        {
          "line": 38,
          "text": "    return UI_SOURCE_TO_ID.get(source, source)"
        }
