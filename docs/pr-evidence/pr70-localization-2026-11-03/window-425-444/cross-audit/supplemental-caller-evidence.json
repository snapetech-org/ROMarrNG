          "line": 1436,
          "text": "const applyInterfaceLanguage=(language=readInterfaceLanguage())=>{"
        },
        {
          "line": 1437,
          "text": "  document.documentElement.lang=language;"
        },
        {
          "line": 1438,
          "text": "  document.documentElement.dir=ROMarrI18n.isRTL(language,UI_CATALOG)?'rtl':'ltr';"
        },
        {
          "line": 1439,
          "text": "  applyTranslatedLabels(document,language);"
        },
        {
          "line": 1440,
          "text": "  applyTranslatedOptionLabels(document,language);"
        },
        {
          "line": 1441,
          "text": "  applyTranslatedTemplates(document,language);"
        },
        {
          "line": 1442,
          "text": "  document.querySelectorAll('[data-i18n-aria-label]').forEach(el=>applyTranslatedAttribute(el,el.dataset.i18nAriaLabel,'aria-label',language));"
        },
        {
          "line": 1443,
          "text": "  document.querySelectorAll('[data-i18n-title]').forEach(el=>applyTranslatedAttribute(el,el.dataset.i18nTitle,'title',language));"
