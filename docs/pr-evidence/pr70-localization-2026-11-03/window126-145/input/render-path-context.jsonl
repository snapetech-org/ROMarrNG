{"evidenceId":"text-node-translation","finding":"Static UI text nodes use the source catalog translation path.","head":"5d999ff7667ae4c5642f1f11b63ad9880d19672c","recordType":"render-path-evidence","snippets":[{"fileSha256":"6876b529337ea468f2b2d8a4151d6c8cc1280f6a03d117a8b7afbd0f74bbdb71","lineEnd":1273,"lineStart":1265,"lines":[{"line":1265,"text":"  const original=translatedTextSources.get(node)||node.data.trim().replace(/\\s+/g,' ');"},{"line":1266,"text":"  if(!hasLabel(original))return;"},{"line":1267,"text":"  translatedTextSources.set(node,original);"},{"line":1268,"text":"  const leading=node.data.match(/^\\s*/)?.[0]||'',trailing=node.data.match(/\\s*$/)?.[0]||'';"},{"line":1269,"text":"  const value=leading+translateLabel(original,language)+trailing;"},{"line":1270,"text":"  if(node.data!==value)node.data=value;"},{"line":1271,"text":"  const translated=Boolean(isTranslated(original,language));"},{"line":1272,"text":"  parent.lang=translated?language:'en';"},{"line":1273,"text":"  parent.dir=translated&&ROMarrI18n.isRTL(language,UI_CATALOG)?'rtl':'ltr';"}],"path":"romarr/ui.py"}]}
{"evidenceId":"explicit-template-rendering","finding":"Explicit UI templates preserve their stable source key and values.","head":"5d999ff7667ae4c5642f1f11b63ad9880d19672c","recordType":"render-path-evidence","snippets":[{"fileSha256":"6876b529337ea468f2b2d8a4151d6c8cc1280f6a03d117a8b7afbd0f74bbdb71","lineEnd":892,"lineStart":882,"lines":[{"line":882,"text":"const interfaceMarkup=source=>'<span data-i18n-key=\"'+esc(stableLocalizationKey(source)||source)+'\">'"},{"line":883,"text":"  +esc(translateLabel(source,readInterfaceLanguage()))+'</span>';"},{"line":884,"text":"const interfacePhraseSpace=()=>/^(?:ja|zh)/.test(readInterfaceLanguage())?'':' ';"},{"line":885,"text":"const interfaceTemplateMarkup=(source,values)=>{"},{"line":886,"text":"  const language=readInterfaceLanguage(),translated=isTranslated(source,language);"},{"line":887,"text":"  return '<span lang=\"'+(translated?esc(language):'en')+'\" dir=\"'"},{"line":888,"text":"    +(translated&&ROMarrI18n.isRTL(language,UI_CATALOG)?'rtl':'ltr')+'\" data-i18n-template-key=\"'"},{"line":889,"text":"    +esc(stableLocalizationKey(source)||source)+'\" data-i18n-values=\"'+esc(JSON.stringify(values))+'\">'"},{"line":890,"text":"    +translatedTemplateMarkup(source,values,language)+'</span>';"},{"line":891,"text":"};"},{"line":892,"text":"const interfaceTitleTemplate=(source,values)=>'title=\"'+esc(translateTemplate(source,values))"}],"path":"romarr/ui.py"}]}
{"evidenceId":"app-owned-status-copy","finding":"App-authored fixed status copy uses the interface catalog.","head":"5d999ff7667ae4c5642f1f11b63ad9880d19672c","recordType":"render-path-evidence","snippets":[{"fileSha256":"6876b529337ea468f2b2d8a4151d6c8cc1280f6a03d117a8b7afbd0f74bbdb71","lineEnd":1080,"lineStart":1071,"lines":[{"line":1071,"text":"};"},{"line":1072,"text":"// Use only for source-owned app copy or diagnostics with an app-owned format."},{"line":1073,"text":"// API/provider/peer values go through apiMessageMarkup instead."},{"line":1074,"text":"const appMessageMarkup=value=>{"},{"line":1075,"text":"  const source=String(value??'');"},{"line":1076,"text":"  if(hasLabel(source)) return interfaceMarkup(source);"},{"line":1077,"text":"  let match=source.match(/^(\\d+) games across (\\d+) (library|libraries)(?:; ([\\s\\S]*))?$/);"},{"line":1078,"text":"  if(match){"},{"line":1079,"text":"    const template=match[3]==='library'"},{"line":1080,"text":"      ?'{games} games across {count} library'"}],"path":"romarr/ui.py"}]}
{"evidenceId":"opaque-api-message-path","finding":"API message rendering has a separate path from source-owned app copy.","head":"5d999ff7667ae4c5642f1f11b63ad9880d19672c","recordType":"render-path-evidence","snippets":[{"fileSha256":"6876b529337ea468f2b2d8a4151d6c8cc1280f6a03d117a8b7afbd0f74bbdb71","lineEnd":1046,"lineStart":1037,"lines":[{"line":1037,"text":"  if(Object.values(values).some(value=>typeof value!=='string'))return fallback;"},{"line":1038,"text":"  return interfaceTemplateMarkup(template.key,values);"},{"line":1039,"text":"};"},{"line":1040,"text":"const apiMessageMarkup=(value,explicitTemplate=null)=>{"},{"line":1041,"text":"  const explicit=explicitTemplateMarkup(explicitTemplate);"},{"line":1042,"text":"  if(explicit)return explicit;"},{"line":1043,"text":"  if(value===null||value===undefined||value==='')return '';"},{"line":1044,"text":"  if(typeof value!=='string'&&typeof value!=='number')return '';"},{"line":1045,"text":"  const source=String(value);"},{"line":1046,"text":"  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"}],"path":"romarr/ui.py"}]}
