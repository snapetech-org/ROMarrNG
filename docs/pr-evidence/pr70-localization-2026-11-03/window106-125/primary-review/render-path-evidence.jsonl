{"evidenceId":"text-node-translation","finding":"Static UI text nodes are translated through the source catalog after normalization.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1279,"lineStart":1267,"lines":[{"line":1267,"text":"  translatedTextSources.set(node,original);"},{"line":1268,"text":"  const leading=node.data.match(/^\\s*/)?.[0]||'',trailing=node.data.match(/\\s*$/)?.[0]||'';"},{"line":1269,"text":"  const value=leading+translateLabel(original,language)+trailing;"},{"line":1270,"text":"  if(node.data!==value)node.data=value;"},{"line":1271,"text":"  const translated=Boolean(isTranslated(original,language));"},{"line":1272,"text":"  parent.lang=translated?language:'en';"},{"line":1273,"text":"  parent.dir=translated&&ROMarrI18n.isRTL(language,UI_CATALOG)?'rtl':'ltr';"},{"line":1274,"text":"};"},{"line":1275,"text":"const applyTranslatedTextTree=(root,language)=>{"},{"line":1276,"text":"  if(root.nodeType===Node.TEXT_NODE){applyTranslatedTextNode(root,language);return;}"},{"line":1277,"text":"  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);"},{"line":1278,"text":"  while(walker.nextNode())applyTranslatedTextNode(walker.currentNode,language);"},{"line":1279,"text":"};"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1418,"lineStart":1414,"lines":[{"line":1414,"text":"    el.dir=translated&&ROMarrI18n.isRTL(language,UI_CATALOG)?'rtl':'ltr';"},{"line":1415,"text":"  });"},{"line":1416,"text":"  applyTranslatedTextTree(document.body,language);"},{"line":1417,"text":"  applyTranslatedAttributes(document.body,language);"},{"line":1418,"text":"  enhanceFormLabels(document.body);"}],"path":"romarr/ui.py"}]}
{"evidenceId":"translated-attributes","finding":"Title and other supported attributes are passed to the source catalog translation path.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1315,"lineStart":1301,"lines":[{"line":1301,"text":"const applyTranslatedAttributes=(root,language)=>{"},{"line":1302,"text":"  const elements=[];"},{"line":1303,"text":"  if(root.nodeType===Node.ELEMENT_NODE)elements.push(root);"},{"line":1304,"text":"  if(root.querySelectorAll)elements.push(...root.querySelectorAll('[title],[aria-label],[placeholder],[data-i18n-title],[data-i18n-aria-label],[data-i18n-placeholder],[data-i18n-title-template],[data-i18n-title-template-key],[data-i18n-aria-label-template-key]'));"},{"line":1305,"text":"  for(const el of elements){"},{"line":1306,"text":"    for(const [attribute,marker] of [['title','data-i18n-title'],['aria-label','data-i18n-aria-label'],['placeholder','data-i18n-placeholder']]){"},{"line":1307,"text":"      const template=el.getAttribute(marker+'-template-key')??el.getAttribute(marker+'-template');"},{"line":1308,"text":"      if(template!==null){"},{"line":1309,"text":"        let values={};"},{"line":1310,"text":"        try{values=JSON.parse(el.getAttribute(marker+'-values')||'{}')}catch(_){continue}"},{"line":1311,"text":"        if(attribute==='aria-label'){"},{"line":1312,"text":"          applyTranslatedAriaLabelTemplate(el,template,values,language);"},{"line":1313,"text":"          continue;"},{"line":1314,"text":"        }"},{"line":1315,"text":"        el.setAttribute(attribute,translateTemplate(template,values,language));"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1352,"lineStart":1348,"lines":[{"line":1348,"text":"        applyTranslatedLabels(node,readInterfaceLanguage());"},{"line":1349,"text":"        applyTranslatedTemplates(node,readInterfaceLanguage());"},{"line":1350,"text":"        applyTranslatedTextTree(node,readInterfaceLanguage());"},{"line":1351,"text":"        applyTranslatedAttributes(node,readInterfaceLanguage());"},{"line":1352,"text":"      }"}],"path":"romarr/ui.py"}]}
{"evidenceId":"app-owned-status-copy","finding":"App-authored fixed status labels use the interface catalog; opaque API/provider values bypass that lookup.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1077,"lineStart":1072,"lines":[{"line":1072,"text":"// Use only for source-owned app copy or diagnostics with an app-owned format."},{"line":1073,"text":"// API/provider/peer values go through apiMessageMarkup instead."},{"line":1074,"text":"const appMessageMarkup=value=>{"},{"line":1075,"text":"  const source=String(value??'');"},{"line":1076,"text":"  if(hasLabel(source)) return interfaceMarkup(source);"},{"line":1077,"text":"  let match=source.match(/^(\\d+) games across (\\d+) (library|libraries)(?:; ([\\s\\S]*))?$/);"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":5621,"lineStart":5613,"lines":[{"line":5613,"text":"const organizerMatchDetailsMarkup=(value,confidence,sourceCopy)=>{"},{"line":5614,"text":"  const source=String(value??'');"},{"line":5615,"text":"  // DAT game names and other provider values stay opaque. TitleDB's values are"},{"line":5616,"text":"  // app-authored diagnostics with dynamic IDs/names represented by templates."},{"line":5617,"text":"  if((sourceCopy==='Exact DAT checksum match')"},{"line":5618,"text":"      ||confidence==='title_id_catalog'||ORGANIZER_FIXED_MATCH_DETAILS.has(source))"},{"line":5619,"text":"    return appMessageMarkup(source);"},{"line":5620,"text":"  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"},{"line":5621,"text":"};"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":5743,"lineStart":5734,"lines":[{"line":5734,"text":"      const confidenceLabel={"},{"line":5735,"text":"        dat_verified:'DAT checksum verified',"},{"line":5736,"text":"        title_id_catalog:'TitleDB ID match · bytes unverified',"},{"line":5737,"text":"        provider_suggestion:'Provider suggestion · review',"},{"line":5738,"text":"        local_metadata:'Imported local metadata · review title',"},{"line":5739,"text":"        ambiguous_name:'Ambiguous title · review',"},{"line":5740,"text":"        manual:'Manually confirmed',"},{"line":5741,"text":"        filename_only:'Filename only · review',"},{"line":5742,"text":"        multi_disc:'Likely multi-disc set · review'"},{"line":5743,"text":"      };"}],"path":"romarr/ui.py"}]}
{"evidenceId":"task-result-template","finding":"The failed-download result carries an explicit source key and is rendered through the explicit-template path.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"5d5f1a1dcdf601b8bb9c9d870b3cfebf387ea7e7f17fbbe2b7e9c98c828e0231","lineEnd":2969,"lineStart":2961,"lines":[{"line":2961,"text":"        if not self.store.settings.get(\"blocklist_failed_downloads\", True):"},{"line":2962,"text":"            return {\"blocklisted\": 0, \"regrabbed\": 0,"},{"line":2963,"text":"                    \"message\": \"failed download handling is off\","},{"line":2964,"text":"                    \"message_template\": {"},{"line":2965,"text":"                        \"key\": \"ui.failed-download-handling-is-off.ad2c9dba83\","},{"line":2966,"text":"                        \"values\": {},"},{"line":2967,"text":"                    }}"},{"line":2968,"text":""},{"line":2969,"text":"        try:"}],"path":"romarr/app.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1047,"lineStart":1038,"lines":[{"line":1038,"text":"  return interfaceTemplateMarkup(template.key,values);"},{"line":1039,"text":"};"},{"line":1040,"text":"const apiMessageMarkup=(value,explicitTemplate=null)=>{"},{"line":1041,"text":"  const explicit=explicitTemplateMarkup(explicitTemplate);"},{"line":1042,"text":"  if(explicit)return explicit;"},{"line":1043,"text":"  if(value===null||value===undefined||value==='')return '';"},{"line":1044,"text":"  if(typeof value!=='string'&&typeof value!=='number')return '';"},{"line":1045,"text":"  const source=String(value);"},{"line":1046,"text":"  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"},{"line":1047,"text":"};"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":5884,"lineStart":5879,"lines":[{"line":5879,"text":"          offset:batch.offset,