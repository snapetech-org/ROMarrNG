{"evidenceId":"opaque-api-text","finding":"Without an explicit template, API message values are escaped as opaque text. Organizer reason/error cells use that path, so these source strings are not translated at this head.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1047,"lineStart":1040,"lines":[{"line":1040,"text":"const apiMessageMarkup=(value,explicitTemplate=null)=>{"},{"line":1041,"text":"  const explicit=explicitTemplateMarkup(explicitTemplate);"},{"line":1042,"text":"  if(explicit)return explicit;"},{"line":1043,"text":"  if(value===null||value===undefined||value==='')return '';"},{"line":1044,"text":"  if(typeof value!=='string'&&typeof value!=='number')return '';"},{"line":1045,"text":"  const source=String(value);"},{"line":1046,"text":"  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"},{"line":1047,"text":"};"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":5855,"lineStart":5851,"lines":[{"line":5851,"text":"    const first=batch.count?batch.offset+1:0;"},{"line":5852,"text":"    const last=batch.offset+batch.count;"},{"line":5853,"text":"      const rows=(plan.operations||[]).map(op=>'<tr><td lang=\"und\" dir=\"auto\">'+esc(op.from)+'</td><td lang=\"und\" dir=\"auto\">'+esc(op.to)+'</td><td>'+apiMessageMarkup(op.reason)+'</td></tr>').join('');"},{"line":5854,"text":"      const blocked=(plan.blocked||[]).map(op=>'<tr><td>'+esc(op.identity_id||'')+'</td><td>'+apiMessageMarkup(op.reason||'')+'</td></tr>').join('');"},{"line":5855,"text":"    const safeCount=(plan.operations||[]).length,blockedCount=(plan.blocked||[]).length;"}],"path":"romarr/ui.py"}]}
{"evidenceId":"api-error-opaque","finding":"The existing-gamelist error is raised during publish_esde, returned by the API as raw error text, and passed to messageApi without an explicit localization template. apiMessageMarkup escapes that value as opaque text.","head":"5f0973fb211c24d9b408cdb85c572540a7ab17ff","recordType":"render-path-evidence","snippets":[{"fileSha256":"b6607d543c6b3017d5b6d1e365c3265905b36317ee5ed7f0d6e28b9c8e90ae64","lineEnd":2281,"lineStart":2278,"lines":[{"line":2278,"text":"                    existing_games.setdefault(path_key, game)"},{"line":2279,"text":"            except Exception as exc:"},{"line":2280,"text":"                raise ValueError(\"Existing gamelist.xml is invalid; it was left untouched.\") from exc"},{"line":2281,"text":"        from .frontends import to_gamelist"}],"path":"romarr/organizer.py"},{"fileSha256":"5d5f1a1dcdf601b8bb9c9d870b3cfebf387ea7e7f17fbbe2b7e9c98c828e0231","lineEnd":7129,"lineStart":7121,"lines":[{"line":7121,"text":"            if route.path == \"/api/v1/organizer/publish/esde\":"},{"line":7122,"text":"                if not isinstance(body, dict):"},{"line":7123,"text":"                    return self._json(400, {\"error\": \"expected a JSON object\"})"},{"line":7124,"text":"                try:"},{"line":7125,"text":"                    result = service.organizer.publish_esde("},{"line":7126,"text":"                        str(body.get(\"platform\") or \"\"))"},{"line":7127,"text":"                except (ValueError, OSError) as exc:"},{"line":7128,"text":"                    return self._json(400, {\"error\": str(exc)})"},{"line":7129,"text":"                return self._json(200, result)"}],"path":"romarr/app.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":5912,"lineStart":5906,"lines":[{"line":5906,"text":"  $('#org-esde').onclick=async()=>{"},{"line":5907,"text":"    if(!platform()){message('Choose one platform before publishing its ES-DE gamelist.',true);return;}"},{"line":5908,"text":"    const result=await j('/api/v1/organizer/publish/esde',{method:'POST',"},{"line":5909,"text":"      headers:{'Content-Type':'application/json'},"},{"line":5910,"text":"      body:JSON.stringify({platform:platform()})})"},{"line":5911,"text":"      .catch(()=>({error:'Could not publish the ES-DE gamelist.'}));"},{"line":5912,"text":"    if(result.error){messageApi(result.error,true,result.error_template);return;}"}],"path":"romarr/ui.py"},{"fileSha256":"810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566","lineEnd":1047,"lineStart":1040,"lines":[{"line":1040,"text":"const apiMessageMarkup=(value,explicitTemplate=null)=>{"},{"line":1041,"text":"  const explicit=explicitTemplateMarkup(explicitTemplate);"},{"line":1042,"text":"  if(explicit)return explicit;"},{"line":1043,"text":"  if(value===null||value===undefined||value==='')return '';"},{"line":1044,"text":"  if(typeof value!=='string'&&typeof value!=='number')return '';"},{"line":1045,"text":"  const source=String(value);"},{"line":1046,"text":"  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"},{"line":1047,"text":"};"}],"path":"romarr/ui.py"}]}
