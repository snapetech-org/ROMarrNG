{"evidenceId": "text-node-translation", "finding": "Static UI text is normalized across whitespace and passed to the source catalog lookup.", "head": "6db0b917343fc9fb605f8a4ecfbf9b4c21cebd1b", "recordType": "render-path-evidence", "snippets": [{"fileSha256": "810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566", "lineEnd": 6354, "lineStart": 6352, "lines": [{"line": 6352, "text": "const applyTemplates=root=>{"}, {"line": 6353, "text": "  const textNodes=[];"}, {"line": 6354, "text": "  if(root.nodeType===Node.ELEMENT_NODE&&root.matches('[data-i18n-template-key]'))textNodes.push(root);"}], "path": "romarr/ui.py"}]}
{"evidenceId": "api-message-opaque", "finding": "Without a permitted explicit template, API messages are emitted as opaque lang=und text instead of being looked up in the translation catalog.", "head": "6db0b917343fc9fb605f8a4ecfbf9b4c21cebd1b", "recordType": "render-path-evidence", "snippets": [{"fileSha256": "810ccf901f4c7651aaf78602ae6eb69d471da65076cc6749c3a86367aa42d566", "lineEnd": 1047, "lineStart": 1040, "lines": [{"line": 1040, "text": "const apiMessageMarkup=(value,explicitTemplate=null)=>{"}, {"line": 1041, "text": "  const explicit=explicitTemplateMarkup(explicitTemplate);"}, {"line": 1042, "text": "  if(explicit)return explicit;"}, {"line": 1043, "text": "  if(value===null||value===undefined||value==='')return '';"}, {"line": 1044, "text": "  if(typeof value!=='string'&&typeof value!=='number')return '';"}, {"line": 1045, "text": "  const source=String(value);"}, {"line": 1046, "text": "  return '<span lang=\"und\" dir=\"auto\">'+esc(source)+'</span>';"}, {"line": 1047, "text": "};"}], "path": "romarr/ui.py"}]}
